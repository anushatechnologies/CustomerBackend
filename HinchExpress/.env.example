# HinchExpress Delivery Operations Configuration
SERVER_PORT=9001

# Database Configuration (Dedicated Database)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hinchexpressdb
DB_USERNAME=root
DB_PASSWORD=root
DB_DDL_AUTO=validate

# Redis Cache & Geospatial
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_ORDER_CONFIRMED=order.confirmed
KAFKA_TOPIC_DELIVERY_EVENTS=delivery.events

# Dispatch Settings
DISPATCH_TIMEOUT_SECONDS=15
DISPATCH_MAX_SEARCH_RADIUS_KM=25.0
