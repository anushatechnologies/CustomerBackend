SERVER_PORT=9000
DB_HOST=hinchmartdb.cj6wwwqcmre0.ap-south-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=hinchmartdb
DB_USERNAME=admin
DB_PASSWORD=your_db_password_here
DB_DDL_AUTO=update
SHOW_SQL=false
FORMAT_SQL=false

# AWS S3 Storage
AWS_REGION=ap-south-2
AWS_S3_BUCKET_NAME=hinchmart-storage-191481838776-ap-south-2-an
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Location & Maps Configuration
LOCATION_PROVIDER=google
MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@hinchmart.com
RESEND_FROM_NAME=HinchMart
RESEND_REPLY_TO=hinchmart@gmail.com

# -------------------------------------------------------------------------------------------------
# Firebase Admin SDK & JWT Authorization Configuration
# You can use ANY ONE of the following 3 options to provide credentials:
# -------------------------------------------------------------------------------------------------

# Option A: Discrete Environment Variables (Recommended for CI/CD & Production)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Option B: Base64 Encoded JSON File (Alternative for single-line secrets)
# FIREBASE_CREDENTIALS_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsCiAgInByb2plY3RfaWQiOiA...

# Option C: Direct JSON String or File Path
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
# FIREBASE_CONFIG_PATH=/app/serviceAccountKey.json
